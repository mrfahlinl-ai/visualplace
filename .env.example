# =============================================================================
# VisualPlace — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# The backend reads these; NEXT_PUBLIC_* values are safe to expose to the browser.
# =============================================================================

# --- App ---
ENVIRONMENT=local            # local | development | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false               # false = pretty console logs in dev
CORS_ORIGINS=http://localhost:3000
SECRET_KEY=dev-insecure-change-me   # REQUIRED in prod; salts audit IP hashes
MAX_REQUEST_BYTES=20971520          # 20 MB hard body cap (defence in depth)

# --- Datastores ---
DATABASE_URL=postgresql+asyncpg://visualplace:visualplace@localhost:5432/visualplace
REDIS_URL=redis://localhost:6379/0

# --- AI provider (vision) ---
AI_PROVIDER=anthropic        # anthropic | openai | google
AI_API_KEY=                  # REQUIRED for analysis; keep secret (server-only)
AI_MODEL=claude-sonnet-5     # vision-capable model id
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_SECONDS=60

# --- Map / place provider ---
MAP_PROVIDER=osm             # osm (keyless) | mapbox | google
MAP_API_KEY=                 # server-side geocoding key (if provider needs one)
MAP_PUBLIC_KEY=              # public token for browser tile rendering ONLY

# --- Web / image search (optional; disabled by default) ---
SEARCH_PROVIDER=none         # none | tavily | serpapi | bing
SEARCH_API_KEY=
IMAGE_SEARCH_API_KEY=

# --- Uploads / limits ---
MAX_UPLOAD_BYTES=15728640    # 15 MB
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif
MAX_IMAGE_PIXELS=40000000    # decompression-bomb guard
VISION_MAX_DIMENSION=1568    # images resized before hitting the vision model

# --- Storage / retention (privacy) ---
STORAGE_PROVIDER=local       # local | s3 | gcs
STORAGE_BUCKET=
STORAGE_LOCAL_DIR=./var/uploads
RETENTION_HOURS=24           # auto-delete window; 0 = delete right after analysis
RETAIN_IMAGES=false          # only keep images if explicitly enabled

# --- Abuse / cost control ---
RATE_LIMIT_PER_MINUTE=20
ANALYZE_DAILY_QUOTA=200

# =============================================================================
# Frontend (Next.js) — public values only
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAP_KEY=         # public map token for client-side rendering ONLY
